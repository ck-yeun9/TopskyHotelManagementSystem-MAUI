<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
             xmlns:local="clr-namespace:EOM.TSHotelManagementSystem.Mobile.UI"  
             xmlns:converters="clr-namespace:EOM.TSHotelManagementSystem.Mobile.UI"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.App">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="appColors" Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary x:Name="appStyles" Source="Resources/Styles/Styles.xaml" />
                <material:StyleResource ColorsOverride="{x:Reference appColors}" BasedOn="{x:Reference appStyles}" />
            </ResourceDictionary.MergedDictionaries>

            <converters:TabToVisibilityConverter x:Key="TabToVisibilityConverter" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
            <converters:IsNotCanceledConverter x:Key="IsNotCanceledConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>