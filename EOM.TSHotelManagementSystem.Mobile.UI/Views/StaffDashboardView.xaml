<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.StaffDashboardView">
    <ScrollView>
        <StackLayout Padding="20" Spacing="16">
            <Label Text="员工快捷管理"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20"/>

            <Frame BackgroundColor="#E3F2FD" CornerRadius="12" Padding="20">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRoomStatusTapped"/>
                </Frame.GestureRecognizers>
                <StackLayout Spacing="8">
                    <Label Text="room" FontFamily="MaterialOutlinedFilled" FontSize="36" HorizontalOptions="Center" TextColor="#1976D2"/>
                    <Label Text="房间状态管理" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="快速更新房间状态并通知后台确认" FontSize="13" TextColor="Gray" HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>

            <Frame BackgroundColor="#E8F5E9" CornerRadius="12" Padding="20">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMeterReadingTapped"/>
                </Frame.GestureRecognizers>
                <StackLayout Spacing="8">
                    <Label Text="bolt" FontFamily="MaterialOutlinedFilled" FontSize="36" HorizontalOptions="Center" TextColor="#388E3C"/>
                    <Label Text="水电抄表记录" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="记录各楼层房间水电表读数" FontSize="13" TextColor="Gray" HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>

            <Frame BackgroundColor="#FFF3E0" CornerRadius="12" Padding="20">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMaterialTapped"/>
                </Frame.GestureRecognizers>
                <StackLayout Spacing="8">
                    <Label Text="inventory" FontFamily="MaterialOutlinedFilled" FontSize="36" HorizontalOptions="Center" TextColor="#F57C00"/>
                    <Label Text="物资管理" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="入库/出库/报损操作" FontSize="13" TextColor="Gray" HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>

            <Button Text="员工登录"
                    x:Name="LoginButton"
                    Clicked="OnStaffLoginClicked"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="44"
                    Margin="0,20,0,0"/>
        </StackLayout>
    </ScrollView>
</ContentView>
