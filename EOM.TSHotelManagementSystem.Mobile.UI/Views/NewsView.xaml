<?xml version="1.0" encoding="utf-8" ?>
<ContentView  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.NewsView">

    <Grid>
        <RefreshView x:Name="RefreshContainer"
             IsRefreshing="{Binding IsRefreshing}"
             Command="{Binding RefreshCommand}"
             RefreshColor="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}">
            <CollectionView x:Name="NewsCollection"
                            ItemsSource="{Binding NewsItems}" 
                            SelectionMode="None"
                            Margin="15"
                            EmptyView="暂无新闻数据">

                <CollectionView.Header>
                    <StackLayout Padding="0,15">
                        <Label Text="最新资讯" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="0"
                               CornerRadius="15"
                               Margin="0,0,0,15"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                               HasShadow="True">

                            <Grid ColumnDefinitions="100,*" RowDefinitions="auto,auto">
                                <Image Source="{Binding ImageUrl, TargetNullValue='placeholder_news.png'}" 
                                       Aspect="AspectFill"
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Grid.RowSpan="2"
                                       HeightRequest="80"
                                       Margin="0">
                                </Image>

                                <StackLayout Grid.Column="1" 
                                             Padding="15"
                                             VerticalOptions="Fill">
                                    <Label Grid.Row="0" 
                                           Grid.Column="1"
                                           Text="{Binding Title}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           VerticalOptions="Center"/>
                                    <Grid HorizontalOptions="Start" 
                                          VerticalOptions="Center"
                                          RowSpacing="0"
                                          ColumnSpacing="10"
                                          Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackLayout Orientation="Horizontal" 
                                                     Spacing="3"
                                                     Grid.Column="0"
                                                     VerticalOptions="Center">
                                            <Label FontFamily="IconFilled" 
                                                   Text="date_range" 
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                                   VerticalTextAlignment="Center"
                                                   VerticalOptions="Center"/>
                                            <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" 
                                                   FontSize="12" 
                                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                                   VerticalTextAlignment="Center"
                                                   VerticalOptions="Center"/>
                                        </StackLayout>

                                        <BoxView Grid.Column="1"
                                                 WidthRequest="1" 
                                                 HeightRequest="10"
                                                 Color="{AppThemeBinding Light=#E0E0E0, Dark=#4D4D4D}"
                                                 VerticalOptions="Center"/>

                                        <StackLayout Orientation="Horizontal" 
                                                     Spacing="3"
                                                     Grid.Column="2"
                                                     VerticalOptions="Center">
                                            <Label FontFamily="IconFilled" 
                                                   Text="visibility" 
                                                   FontSize="12"
                                                   Margin="0,3,0,0"
                                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                                   VerticalTextAlignment="Center"
                                                   VerticalOptions="Center"/>
                                            <Label Text="{Binding ViewCount, StringFormat='{0} 阅读'}"
                                                   FontSize="12" 
                                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                                   VerticalTextAlignment="Center"
                                                   VerticalOptions="Center"/>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#383838}"/>
                                            <Setter Property="Scale" Value="0.98"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <StackLayout Padding="0,10" IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator IsRunning="True" 
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Color="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}"/>
                        <Label Text="正在加载更多..." 
                               HorizontalOptions="Center"
                               FontSize="14"
                               Margin="0,5"/>
                    </StackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator IsRunning="{Binding IsInitializing}" 
                           IsVisible="{Binding IsInitializing}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}"
                           AbsoluteLayout.LayoutBounds="0.5, 0.5, AutoSize, AutoSize"
                           AbsoluteLayout.LayoutFlags="PositionProportional"
                           BackgroundColor="Transparent"/>  
    </Grid>
    
</ContentView>
