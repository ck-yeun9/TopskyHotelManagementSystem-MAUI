<?xml version="1.0" encoding="utf-8" ?>
<ContentView  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.NewsView">

    <Grid>
        <RefreshView x:Name="RefreshContainer"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}">
            <CollectionView x:Name="NewsCollection"
                            ItemsSource="{Binding NewsItems}"
                            SelectionMode="Single"
                            Margin="15"
                            EmptyView="暂无新闻数据">

                <CollectionView.Header>
                    <StackLayout Padding="10" HorizontalOptions="Fill">
                        <Label Text="{Binding PageTitle, FallbackValue='新闻资讯'}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="0"
                               CornerRadius="15"
                               Margin="0,0,0,15"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                               HasShadow="True">

                            <Grid ColumnDefinitions="100,*" RowDefinitions="auto,auto">
                                <Image Source="{Binding ImageUrl, TargetNullValue='placeholder_news.png'}" 
                                       Aspect="AspectFill"
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Grid.RowSpan="2"
                                       HeightRequest="80"
                                       Margin="0">
                                </Image>

                                <StackLayout Grid.Column="1" 
                                             Padding="15"
                                             VerticalOptions="Fill">
                                    <Label Grid.Row="0" 
                                           Grid.Column="1"
                                           Text="{Binding Title}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           VerticalOptions="Center"/>
                                    <HorizontalStackLayout Spacing="3"
                                                             VerticalOptions="Center">
                                        <Label FontFamily="MaterialOutlinedFilled" 
                                               Text="date_range" 
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                               VerticalTextAlignment="Center"
                                               VerticalOptions="Center"/>

                                        <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                               VerticalTextAlignment="Center"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </StackLayout>
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#383838}"/>
                                            <Setter Property="Scale" Value="0.98"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <StackLayout Padding="0,10" IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator IsRunning="True" 
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Color="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}"/>
                        <Label Text="正在加载更多..." 
                               HorizontalOptions="Center"
                               FontSize="14"
                               Margin="0,5"/>
                    </StackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator IsRunning="{Binding IsInitializing}" 
                           IsVisible="{Binding IsInitializing}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}"
                           AbsoluteLayout.LayoutBounds="0.5, 0.5, AutoSize, AutoSize"
                           AbsoluteLayout.LayoutFlags="PositionProportional"
                           BackgroundColor="Transparent"/>  
    </Grid>
    
</ContentView>
