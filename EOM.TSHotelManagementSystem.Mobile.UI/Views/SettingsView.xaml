<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EOM.TSHotelManagementSystem.Mobile.UI.Controls"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.SettingsView"
             Title="系统设置"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0" Title="系统设置" ShowBack="True" />
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="外观" FontSize="18" FontAttributes="Bold"/>
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray">
                <Grid ColumnDefinitions="*,auto">
                    <Label Text="深色模式" VerticalOptions="Center" FontSize="16"/>
                    <Switch Grid.Column="1" IsToggled="{Binding IsDarkMode}"
                            ThumbColor="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}"/>
                </Grid>
            </Frame>

            <Label Text="安全" FontSize="18" FontAttributes="Bold"/>
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray"
                   IsVisible="{Binding IsBiometricAvailable}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,auto">
                        <Label Text="生物识别登录" VerticalOptions="Center" FontSize="16"/>
                        <Switch Grid.Column="1" IsToggled="{Binding IsBiometricEnabled}"
                                ThumbColor="{AppThemeBinding Light=#FF5722, Dark=#FF9B6A}"/>
                    </Grid>
                    <Label Text="开启后可使用指纹或面容快速登录" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}"/>
                </VerticalStackLayout>
            </Frame>
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray"
                   IsVisible="{Binding IsBiometricAvailable, Converter={StaticResource InvertBoolConverter}}">
                <Label Text="您的设备不支持生物识别或未登录" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}"/>
            </Frame>

            <Label Text="其他" FontSize="18" FontAttributes="Bold"/>
            <Button StyleClass="OutlinedButton" Text="清除缓存"
                    Command="{Binding ClearCacheCommand}"/>

            <Label Text="关于" FontSize="18" FontAttributes="Bold"/>
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,auto">
                        <Label Text="应用版本" VerticalOptions="Center" FontSize="16"/>
                        <Label Grid.Column="1" Text="{Binding AppVersion}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,auto">
                        <Label Text="应用名称" VerticalOptions="Center" FontSize="16"/>
                        <Label Grid.Column="1" Text="TopSky酒店" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
