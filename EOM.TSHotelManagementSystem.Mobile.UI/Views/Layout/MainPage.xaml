<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
             xmlns:controls="clr-namespace:EOM.TSHotelManagementSystem.Mobile.UI"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.MainPage"
             Title="{Binding CurrentTitle}">
    <Grid RowDefinitions="*,Auto">
        <ContentView x:Name="ContentHost" Grid.Row="0" />

        <controls:BottomNavigationBar 
            Grid.Row="1" 
            ActiveTab="{Binding ActiveTab, Mode=TwoWay}"
            TabSelected="OnTabSelected"
            x:Name="BottomNavBar"/>
    </Grid>
</ContentPage>