<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EOM.TSHotelManagementSystem.Mobile.UI.Controls"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.EvaluationStatsView"
             x:Name="StatsPage"
             Title="房间评价"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0" Title="房间评价" ShowBack="True" />
        <RefreshView Grid.Row="1"
                     RefreshColor="#FF5722"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding RefreshCommand}">
        <ScrollView>
        <VerticalStackLayout Padding="16,16,16,72" Spacing="14">

            <Label>
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding RoomName}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" />
                        <Span Text="{Binding RoomNumber, StringFormat='   房号：{0}'}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- 综合评分 -->
            <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardSurfaceDark}}" Padding="16">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding Statistics.AvgOverall, StringFormat='{0:F1}'}"
                           FontSize="44" FontAttributes="Bold" TextColor="#FF5722"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Padding="12,0,0,0" VerticalOptions="Center">
                        <controls:StarRatingControl IsReadOnly="True" Score="{Binding AvgOverallStars}" />
                        <Label Text="{Binding Statistics.TotalCount, StringFormat='共 {0} 条评价'}"
                               FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- 各维度评分 -->
            <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardSurfaceDark}}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="维度评分" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="卫生状况" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" VerticalOptions="Center" />
                        <controls:StarRatingControl Grid.Row="0" Grid.Column="1" IsReadOnly="True" Score="{Binding AvgCleanlinessStars}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="服务态度" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" VerticalOptions="Center" />
                        <controls:StarRatingControl Grid.Row="1" Grid.Column="1" IsReadOnly="True" Score="{Binding AvgServiceStars}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="舒适度" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" VerticalOptions="Center" />
                        <controls:StarRatingControl Grid.Row="2" Grid.Column="1" IsReadOnly="True" Score="{Binding AvgComfortStars}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="设施与位置" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" VerticalOptions="Center" />
                        <controls:StarRatingControl Grid.Row="3" Grid.Column="1" IsReadOnly="True" Score="{Binding AvgLocationStars}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 评分分布 -->
            <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardSurfaceDark}}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="评分分布" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" />
                    <CollectionView ItemsSource="{Binding DistributionItems}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8" Padding="2">
                                    <Label Grid.Column="0" Text="{Binding Star, StringFormat='{0}★'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}" />
                                    <Border Grid.Column="1" BackgroundColor="#FFE7D6" StrokeShape="RoundRectangle 5" HeightRequest="10">
                                        <BoxView BackgroundColor="#FF5722" HeightRequest="10" HorizontalOptions="Start" CornerRadius="5" WidthRequest="{Binding Width}" />
                                    </Border>
                                    <Label Grid.Column="2" Text="{Binding Count}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 最近点评 -->
            <Label Text="{Binding CommentCountLabel}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" />
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#FF5722" />
            <CollectionView ItemsSource="{Binding RecentComments}" SelectionMode="None" EmptyView="暂无评价"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       HeightRequest="40"
                                       Color="#FF5722"
                                       Margin="0,4,0,12" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardSurfaceDark}}" Padding="14" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <controls:StarRatingControl IsReadOnly="True" Score="{Binding OverallScore}" />
                                    <!-- 用户名（匿名显示"匿名用户"，非匿名显示姓名或编号） -->
                                    <Label Grid.Column="1"
                                           Text="{Binding UserName}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="#FF5722" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Comment}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=#E8E8E8}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding DataInsDate, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                       FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
        </ScrollView>
        </RefreshView>

        <!-- 固定底部：写评价按钮（FAB 风格，浮在内容之上，不占独立行） -->
        <Button Grid.Row="1"
                Text="✎"
                FontSize="24"
                BackgroundColor="#FF5722"
                TextColor="White"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                Padding="0"
                BorderWidth="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,16,24"
                Command="{Binding WriteReviewCommand}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E64A19" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#BF360C" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>
    </Grid>
</ContentPage>
