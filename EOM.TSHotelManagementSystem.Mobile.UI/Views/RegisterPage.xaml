<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.RegisterPage"
             Title="注册"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
    <ScrollView>
        <StackLayout Padding="30" Spacing="25">
            <Image Source="logo.png" HeightRequest="100" HorizontalOptions="Center"/>

            <Entry Placeholder="用户名" 
                   Text="{Binding Username}"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

            <Entry Placeholder="邮箱" 
                   Text="{Binding Email}"
                   Keyboard="Email"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

            <Entry Placeholder="密码" 
                   Text="{Binding Password}"
                   IsPassword="True"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

            <Entry Placeholder="确认密码" 
                   Text="{Binding ConfirmPassword}"
                   IsPassword="True"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

            <Button Text="注册" 
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <Button Text="返回登录" 
                    Command="{Binding NavigateToLoginCommand}"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                    TextColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="#FF453A" 
                   HorizontalOptions="Center" 
                   IsVisible="{Binding HasErrorMessage}"/>
        </StackLayout>
    </ScrollView>
</ContentPage>