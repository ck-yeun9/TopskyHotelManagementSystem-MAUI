<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EOM.TSHotelManagementSystem.Mobile.UI.Controls"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.NewsDetailView"
             Title="新闻详情"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0" Title="新闻详情" ShowBack="True" />
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Image Source="{Binding ImageUrl}" 
                   Aspect="AspectFill"
                   HeightRequest="200"
                   IsVisible="{Binding HasImage}"
                   Margin="0,0,0,5"/>

            <Label Text="{Binding Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#212121, Dark=White}"/>

            <Grid ColumnDefinitions="auto,auto,auto,auto,auto" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark=#B0B0B0}"/>
                <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="10" Color="LightGray" VerticalOptions="Center"/>
                <Label Grid.Column="2"
                       Text="{Binding Type}"
                       FontSize="12"
                       TextColor="#FF5722"/>
                <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="10" Color="LightGray" VerticalOptions="Center"/>
                <Label Grid.Column="4"
                       Text="{Binding Status}"
                       FontSize="12"
                       TextColor="#4CAF50"/>
            </Grid>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#4D4D4D}"/>

            <Label Text="{Binding Content}"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light=#424242, Dark=#BDBDBD}"
                   LineHeight="1.5"/>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
