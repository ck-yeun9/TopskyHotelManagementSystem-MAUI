<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:controls="clr-namespace:EOM.TSHotelManagementSystem.Mobile.UI"
      xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
      x:Class="EOM.TSHotelManagementSystem.Mobile.UI.BottomNavigationBar"
      BackgroundColor="#f8f8f8"
      HeightRequest="60"
      ColumnDefinitions="*,*,*">

    <Border x:Name="NewsBorder"
            Grid.Column="0"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <StackLayout Spacing="2" Padding="16,4" x:Name="NewsLayout">
            <Label FontFamily="MaterialOutlinedFilled"
                   Text="newspaper"
                   FontSize="24"
                   InputTransparent="True"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   x:Name="NewsIcon" />
            <Label Text="新闻" 
                   FontSize="12"
                   InputTransparent="True"
                   x:Name="NewsLabel"/>
        </StackLayout>
    </Border>

    <Border x:Name="CheckInBorder"
            Grid.Column="1"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <StackLayout Spacing="2" Padding="16,4" x:Name="CheckInLayout">
            <Label FontFamily="MaterialOutlinedFilled"
                   Text="luggage"
                   FontSize="24"
                   InputTransparent="True"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   x:Name="CheckInIcon"/>
            <Label Text="入住" 
                   FontSize="12"
                   InputTransparent="True"
                   x:Name="CheckInLabel"/>
        </StackLayout>
    </Border>

    <Border x:Name="ProfileBorder"
            Grid.Column="2"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <StackLayout Spacing="2" Padding="16,4" x:Name="ProfileLayout">
            <Label FontFamily="MaterialOutlinedFilled"
                   Text="person"
                   FontSize="24"
                   InputTransparent="True"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   x:Name="ProfileIcon"/>
            <Label Text="我的" 
                   FontSize="12"
                   InputTransparent="True"
                   x:Name="ProfileLabel"/>
        </StackLayout>
    </Border>
</Grid>
