<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.LoginPage"
             Title="登录"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">

    <ScrollView>
        <StackLayout Padding="30" Spacing="25">
            <Image Source="logo.png" HeightRequest="100" HorizontalOptions="Center"/>

            <Entry Placeholder="用户名/邮箱" 
                   Text="{Binding Username}"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

            <Entry Placeholder="密码" 
                   Text="{Binding Password}"
                   IsPassword="True"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

            <Button Text="登录" 
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <Button Text="注册" 
                    Command="{Binding NavigateToRegisterCommand}"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                    TextColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="#FF453A" 
                   HorizontalOptions="Center" 
                   IsVisible="{Binding HasErrorMessage}"/>
        </StackLayout>
    </ScrollView>
</ContentPage>