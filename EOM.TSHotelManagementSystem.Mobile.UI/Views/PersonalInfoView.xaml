<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="EOM.TSHotelManagementSystem.Mobile.UI.PersonalInfoView"
             Title="个人信息">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray">
                <VerticalStackLayout Spacing="10">
                    <Grid HeightRequest="80" WidthRequest="80" HorizontalOptions="Center">
                        <Label FontFamily="MaterialOutlinedFilled"
                               Text="account_circle"
                               FontSize="80"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasPhoto, Converter={StaticResource InvertBoolConverter}}" />
                        <Image Source="{Binding PhotoUrl}"
                               HeightRequest="80" WidthRequest="80"
                               Aspect="AspectFill"
                               IsVisible="{Binding HasPhoto}"/>
                    </Grid>
                    <Label Text="{Binding DisplayName}" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="{Binding Account}" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="账号信息" FontSize="18" FontAttributes="Bold"/>
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="80,*" RowDefinitions="auto,auto">
                        <Label Text="昵称" VerticalOptions="Center" TextColor="Gray"/>
                        <Label Grid.Column="1" Text="{Binding DisplayName}" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Text="账号" VerticalOptions="Center" TextColor="Gray"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Account}" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="个人信息" FontSize="18" FontAttributes="Bold"/>
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray">
                <VerticalStackLayout Spacing="14">
                    <material:TextField Title="昵称" Text="{Binding EditName}" />
                    <material:TextField Title="邮箱" Text="{Binding EditEmail}" Keyboard="Email" />
                    <material:TextField Title="手机号" Text="{Binding EditPhone}" Keyboard="Telephone" />
                    <material:TextField Title="地址" Text="{Binding EditAddress}" />
                    <Label Text="生日" FontSize="12" TextColor="Gray" />
                    <DatePicker Date="{Binding EditBirthDate}" MinimumDate="1900-01-01" />
                    <Label Text="性别" FontSize="12" TextColor="Gray" />
                    <Picker ItemsSource="{Binding GenderOptions}"
                            SelectedIndex="{Binding SelectedGenderIndex}"
                            Title="请选择性别" />
                    <Label Text="民族" FontSize="12" TextColor="Gray" />
                    <Picker ItemsSource="{Binding NationNames}"
                            SelectedIndex="{Binding SelectedNationIndex}"
                            Title="请选择民族" />
                    <Label Text="学历" FontSize="12" TextColor="Gray" />
                    <Picker ItemsSource="{Binding EducationNames}"
                            SelectedIndex="{Binding SelectedEducationIndex}"
                            Title="请选择学历" />
                    <Grid ColumnDefinitions="80,*">
                        <Label Text="客户类型" VerticalOptions="Center" TextColor="Gray"/>
                        <Label Grid.Column="1" Text="{Binding CustomerTypeDisplay}" VerticalOptions="Center"/>
                    </Grid>
                    <Button Text="保存信息"
                            StyleClass="FilledButton"
                            Command="{Binding SaveProfileCommand}"
                            HeightRequest="48" />
                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Frame>

            <Button StyleClass="OutlinedButton" Text="修改密码"
                    Command="{Binding TogglePasswordSectionCommand}"/>

            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray"
                   IsVisible="{Binding IsChangingPassword}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="修改密码" FontSize="18" FontAttributes="Bold"/>
                    <material:TextField Title="当前密码" IsPassword="True"
                                        Text="{Binding CurrentPassword}"/>
                    <material:TextField Title="新密码" IsPassword="True"
                                        Text="{Binding NewPassword}"/>
                    <material:TextField Title="确认新密码" IsPassword="True"
                                        Text="{Binding ConfirmPassword}"/>
                    <Button Text="确认修改" 
                            StyleClass="FilledButton"
                            Command="{Binding ChangePasswordCommand}"
                            HeightRequest="48"/>
                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding StatusMessage}" TextColor="{Binding StatusMessageColor}"
                   IsVisible="True" LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
